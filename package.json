{
  "name": "bit",
  "version": "0.6.0",
  "private": true,
  "description": "Bit — version control for Excel. M6: Ask for review, Needs a decision, Combine into Main.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "roundtrip": "tsx scripts/roundtrip.ts",
    "api": "tsx src/api/server.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "npm run dev --prefix web",
    "dev": "npm run api"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
